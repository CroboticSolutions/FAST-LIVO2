<launch>
<!-- Launch file for Livox AVIA LiDAR -->

	<arg name="rviz" default="true" />
	<arg name="real_robot" default="false" />
	<arg name="use_pc_time" default="false" />

	<rosparam command="load" file="$(find fast_livo)/config/robosense_airy.yaml" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find fast_livo)/config/camera_pinhole.yaml" /> 
	</node>

	<!-- here goes the TF between robot and LIDAR -->
        <!-- no TF between world and rs_lidar (seems ok in world frame for now, myb included in config already !-->
        <!-- what are the exact extrinsicts and what should we expect, where should pointcloud should in lidar"!-->
		<!-- rslidar_imu → rslidar: from extrinsic_T/R (factory IMU-LiDAR calibration inside Airy) -->
    <!--node pkg="tf" type="static_transform_publisher" name="rslidar_imu_to_rslidar"
        args="0.004156 0.004265 -0.004468 0.70711 -0.70709 0.001831 0.000660 rslidar_imu rslidar 100" /-->

	<!-- rslidar → minithex_base: inverse of CAD model transform -->
	<!-- -->
    <!--node pkg="tf" type="static_transform_publisher" name="rslidar_to_minithex_base"
        args="-0.000011 0.03847 -0.03931 3.14 0.0 -2.35619 rslidar minithex_base 100" /-->

	<!-- Publish world -> minithex_base as PoseStamped on /tf_pose/world_to_minithex_base -->
	<!--node pkg="fast_livo" type="tf_to_pose.py" name="tf_to_pose" output="screen" /-->

	<!-- When running on the real robot, relay /aft_mapped_to_init odometry as world→minithex_base TF -->
	<!--group if="$(arg real_robot)">
		<node pkg="fast_livo" type="odom_to_tf.py" name="odom_to_tf" output="screen" />
	</group-->
	
	<!--  <group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group> 
	
	<node pkg="image_transport" type="republish" name="republish" args="compressed in:=/left_camera/image raw out:=/left_camera/image" output="screen" respawn="true"/> -->

launch-prefix="gdb -ex run --args"
launch-prefix="valgrind --leak-check=full"



</launch> 	
